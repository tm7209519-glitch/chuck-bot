{
  "name": "chuck-bot-desktop",
  "version": "0.1.1",
  "description": "Chuck Bot desktop shell — a thin Electron client that bundles and manages the local Xiryn (Next.js) service.",
  "main": "main/index.js",
  "private": true,
  "author": "Chuck Bot",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "scripts\\dev.cmd",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.chuckbot.desktop",
    "productName": "Chuck Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-root",
        "to": "app-root"
      },
      {
        "from": "resources/node",
        "to": "node"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "tm7209519-glitch",
      "repo": "chuck-bot",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
